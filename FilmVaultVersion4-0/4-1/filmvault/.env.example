# ──────────────────────────────────────────────────────────────
#  FilmVault – Konfiguration
#  Kopiere diese Datei zu ".env" und trage deine Werte ein.
#  Die .env liegt neben der App (nicht im filmvault/-Paket).
# ──────────────────────────────────────────────────────────────


# ── OMDb / IMDb ───────────────────────────────────────────────
#
#  Kostenloser API-Key unter: https://www.omdbapi.com/apikey.aspx
#  Ohne diesen Key läuft die App normal, aber ohne IMDb-Suche
#  und ohne automatisches Befüllen von Genre, Laufzeit und Poster.
#
OMDB_API_KEY=dein_omdb_api_key_hier


# ── Firebase ──────────────────────────────────────────────────
#
#  Nur nötig wenn du den persönlichen Cloudbereich oder
#  die Gruppenfunktion nutzen möchtest.
#
#  Wo findest du diese Werte?
#  → Firebase Console → Projekteinstellungen → Deine Apps → Web-App
#  → Dort stehen apiKey und projectId in der firebaseConfig.
#
#  Kein Service-Account und keine JSON-Datei nötig.
#  Die App nutzt ausschließlich die Firebase Web-API.
#
FIREBASE_WEB_API_KEY=dein_firebase_web_api_key_hier
FIREBASE_PROJECT_ID=dein-firebase-projekt-id-hier
